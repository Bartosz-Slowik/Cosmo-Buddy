# XIAO ESP32S3: 8 MB flash
CONFIG_ESPTOOLPY_FLASHSIZE_8MB=y
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
CONFIG_FREERTOS_HZ=1000
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192
# D7 (GPIO44) is UART0 RX and drives the OLED, so logs go over the USB port instead
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y
CONFIG_BT_ENABLED=y
CONFIG_BT_BLE_ENABLED=y
CONFIG_BT_BLUEDROID_ENABLED=n
CONFIG_BT_NIMBLE_ENABLED=y
# The screen mirror sends 8 packets per frame; the default 24 buffers run out
CONFIG_BT_NIMBLE_MSYS_1_BLOCK_COUNT=64
